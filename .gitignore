# ---------------------------------------------------------------------------
# Personal media library — NEVER commit.
# This folder holds the user's own ripped film files (~16GB of copyrighted
# video). It is scanned at runtime and its path is configurable in Settings,
# so nothing in the app depends on it being in the repo.
# ---------------------------------------------------------------------------
Movies & Shows/
*.mp4
*.mkv
*.avi
*.mov
*.webm

# ---------------------------------------------------------------------------
# Dependencies and build output (regenerated by `npm install` / `npm run build`)
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
*.deb
*.AppImage
*.rpm
*.exe
*.dmg
*.blockmap

# ---------------------------------------------------------------------------
# Generated data. The animal database is built by the scripts in scripts/,
# not stored here — it lives in ~/.config/jurassic-ai-dashboard/ and reaches
# ~500MB with the full GBIF backbone imported.
# ---------------------------------------------------------------------------
*.duckdb
*.duckdb.wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Large source dumps downloaded by the import scripts (see docs/RESEARCH_NOTES.md)
*.txt.gz
VernacularName.tsv
simple.txt.gz

# ---------------------------------------------------------------------------
# Logs, temp, OS/editor cruft
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Claude Code local settings (machine-specific)
.claude/
